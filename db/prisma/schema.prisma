// PawDrop — Prisma schema
// Stage 2 of the build. Postgres. Every model below is used by at least
// one feature described in the master spec (buyer/seller/admin, mystery
// unlocks, points economy, social, gamification, AI scoring, moderation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum UploadStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ScoreTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  LEGENDARY
}

enum EnergyLevel {
  CALM
  MODERATE
  ENERGETIC
  HYPER
}

enum AgeCategory {
  PUPPY
  YOUNG
  ADULT
  SENIOR
}

enum TransactionType {
  UNLOCK_SPEND
  SALE_EARNING
  PLATFORM_COMMISSION
  ADMIN_ADJUSTMENT
  SIGNUP_BONUS
  DAILY_LOGIN_BONUS
  MISSION_REWARD
  ACHIEVEMENT_REWARD
  REFUND
  WITHDRAWAL_HOLD
  REFERRAL_BONUS
  REWARD_REDEMPTION
  CONTEST_PRIZE
  BUNDLE_SPEND
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_LIKE
  NEW_COMMENT
  COMMENT_REPLY
  UPLOAD_APPROVED
  UPLOAD_REJECTED
  PHOTO_UNLOCKED
  ACHIEVEMENT_UNLOCKED
  BADGE_AWARDED
  LEVEL_UP
  MISSION_COMPLETED
  STREAK_MILESTONE
  POINTS_RECEIVED
  ADMIN_NOTICE
  ACCOUNT_WARNING
  FEATURED
  REFERRAL_JOINED
  REFERRAL_REWARDED
  REWARD_REDEEMED
  CONTEST_ENTRY_RECEIVED_VOTE
  CONTEST_WON
  SAVED_SEARCH_MATCH
}

enum MissionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum ModerationFlag {
  SAFE
  NEEDS_REVIEW
  LIKELY_DUPLICATE
  LIKELY_NOT_A_DOG
}

enum RewardCategory {
  PROFILE_BADGE
  FEATURE_BOOST
  COMMISSION_DISCOUNT
}

enum ContestStatus {
  UPCOMING
  ACTIVE
  VOTING_CLOSED
  COMPLETED
}

enum ReportTargetType {
  PHOTO
  COMMENT
  USER
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  COPYRIGHT
  SPAM
  HARASSMENT
  MISLEADING
  FAKE_ACCOUNT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum CollectionVisibility {
  PUBLIC
  PRIVATE
}

// ────────────────────────────────────────────────────────────────────────
// AUTH (Auth.js / NextAuth v5 Prisma adapter contract + custom 2FA/reset)
// ────────────────────────────────────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  emailVerified     DateTime?
  hashedPassword    String?
  name              String?
  username          String        @unique
  image             String?
  bannerImage       String?
  bio               String?       @db.VarChar(500)

  roles             Role[]        @default([BUYER])
  primaryRole       Role          @default(BUYER)
  status            AccountStatus @default(ACTIVE)

  // 2FA
  twoFactorEnabled  Boolean       @default(false)
  twoFactorSecret   String?

  // Economy / gamification (denormalized for fast reads; PointTransaction is source of truth)
  pointsBalance     Int           @default(0)
  xp                Int           @default(0)
  level             Int           @default(1)
  reputationScore   Float         @default(0)
  streakCount       Int           @default(0)
  longestStreak     Int           @default(0)
  lastActiveDate    DateTime?

  suspendedAt       DateTime?
  suspendedReason   String?
  bannedAt          DateTime?
  bannedReason      String?

  // Referrals — every user gets a stable, shareable code at creation. The
  // default is generated by Postgres itself (`dbgenerated`), not by
  // application code, specifically so it's populated even for rows the
  // Auth.js PrismaAdapter creates directly on a Google OAuth sign-in,
  // which never passes through our own register() Server Action.
  // `referredById` is only set for users who signed up *through* someone
  // else's code, and `referralRewardedAt` guards the one-time bonus so a
  // buyer churning through unlock/refund/re-unlock cycles can't farm it.
  referralCode        String    @unique @default(dbgenerated("substr(md5(random()::text), 1, 8)"))
  referredById        String?
  referralRewardedAt  DateTime?

  // Seller-side commission discount, grantable via the rewards catalog
  // (see RewardItem/RewardRedemption) — read by the unlock transaction's
  // commission calculation alongside the platform default.
  commissionDiscountPercent Int      @default(0)
  commissionDiscountUntil  DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Auth.js relations
  accounts               Account[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  twoFactorTokens         TwoFactorToken[]

  referredBy              User?                  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                 @relation("Referrals")

  // Seller relations
  photos                  Photo[]                @relation("SellerPhotos")
  approvedPhotos          Photo[]                @relation("ApprovedBy")
  sellerMonthlyStats      SellerMonthlyStat[]
  featuredAs              FeaturedCreator[]      @relation("FeaturedSeller")

  // Buyer relations
  unlocks                 MysteryUnlock[]
  wishlistItems           Wishlist[]
  savedSearchAlerts       SavedSearchAlert[]
  bundleUnlocks           BundleUnlock[]

  // Points
  pointTransactions       PointTransaction[]

  // Growth / engagement (Stage 15)
  activityLogs            ActivityLog[]
  seasonScores            SeasonScore[]
  rewardRedemptions       RewardRedemption[]
  contestEntries          ContestEntry[]
  contestVotes            ContestVote[]
  pushSubscriptions       PushSubscription[]
  bundlesCreated          Bundle[]               @relation("BundleCreatedBy")

  // Social
  likes                   Like[]
  comments                Comment[]
  commentReactions        CommentReaction[]
  following               Follow[]               @relation("Follower")
  followedBy              Follow[]               @relation("Following")
  collections             Collection[]
  bookmarks               Bookmark[]

  // Gamification
  achievements            UserAchievement[]
  missions                UserMission[]
  badges                  UserBadge[]

  // Notifications
  notifications           Notification[]

  // Moderation / admin
  reportsFiled            Report[]               @relation("Reporter")
  reportsReviewed         Report[]                @relation("ReviewedBy")
  reportsAgainst          Report[]                @relation("ReportedUser")
  auditLogs               AuditLog[]              @relation("Actor")
  announcementsCreated    Announcement[]          @relation("AnnouncementAuthor")
  platformSettingsUpdated PlatformSetting[]       @relation("SettingUpdatedBy")
  featuredCreated         FeaturedCreator[]       @relation("FeaturedCreatedBy")
  searchQueries           SearchQuery[]

  @@index([username])
  @@index([status])
  @@index([primaryRole])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────
// TAXONOMY
// ────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos Photo[]

  @@index([slug])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())

  photos PhotoTag[]

  @@index([slug])
}

model PhotoTag {
  photoId String
  tagId   String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId])
}

// ────────────────────────────────────────────────────────────────────────
// PHOTOS / UPLOADS + AI SCORING
// ────────────────────────────────────────────────────────────────────────

model Photo {
  id                 String       @id @default(cuid())
  sellerId           String

  title               String
  description         String?      @db.VarChar(1000)

  // Cloudinary
  cloudinaryPublicId  String
  url                 String
  blurredUrl          String
  width               Int
  height              Int

  // Marketplace metadata
  breed               String?
  ageCategory         AgeCategory?
  color               String?
  energyLevel         EnergyLevel?
  categoryId          String?

  price               Int          @default(10)
  status              UploadStatus @default(PENDING)
  rejectionReason     String?

  // Denormalized from PhotoScore for fast sort/filter in the marketplace
  overallScore        Float?
  scoreTier           ScoreTier?

  viewCount           Int          @default(0)
  unlockCount         Int          @default(0)
  likeCount           Int          @default(0)
  commentCount        Int          @default(0)

  isFeatured          Boolean      @default(false)

  // Duplicate detection (average-hash of the pixel content, computed at
  // upload time — see services/moderation/perceptual-hash.ts) and AI
  // content moderation (see services/ai-scoring, which now also returns an
  // isDogPhoto/moderation opinion alongside the cuteness score).
  imageHash           String?
  moderationFlag      ModerationFlag @default(SAFE)
  duplicateOfPhotoId  String?

  approvedById        String?
  approvedAt          DateTime?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  withdrawnAt         DateTime?

  seller       User            @relation("SellerPhotos", fields: [sellerId], references: [id], onDelete: Cascade)
  approvedBy   User?           @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  duplicateOf  Photo?          @relation("PhotoDuplicates", fields: [duplicateOfPhotoId], references: [id], onDelete: SetNull)
  flaggedDuplicates Photo[]     @relation("PhotoDuplicates")

  score        PhotoScore?
  tags         PhotoTag[]
  unlocks      MysteryUnlock[]
  likes        Like[]
  comments     Comment[]
  wishlistedBy Wishlist[]
  bookmarks    Bookmark[]
  collectionItems CollectionItem[]
  reports      Report[]        @relation("ReportedPhoto")
  featuredRuns FeaturedCreator[] @relation("FeaturedPhoto")
  contestEntries ContestEntry[]
  bundleEntries  BundlePhoto[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([price])
  @@index([overallScore])
  @@index([scoreTier])
  @@index([isFeatured])
  @@index([imageHash])
  @@index([moderationFlag])
}

// One AI scoring result per photo. Full breakdown lives here; the
// summary fields are copied onto Photo for query performance.
model PhotoScore {
  id                String   @id @default(cuid())
  photoId           String   @unique

  overallScore      Float
  cutenessScore     Float
  compositionScore  Float
  lightingScore     Float
  sharpnessScore    Float
  emotionScore      Float
  colorBalanceScore Float

  suggestedPrice    Int
  confidenceScore   Float
  explanation       String   @db.Text

  // Content moderation opinion, from the same vision-model call as the
  // score (see services/ai-scoring) — surfaced to admins in the
  // moderation queue rather than silently auto-rejecting, since a vision
  // model's "is this a dog" call is a hint, not a ground truth.
  isDogPhoto        Boolean  @default(true)
  moderationNote    String?

  modelUsed         String
  rawResponse       Json?

  createdAt         DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────
// MYSTERY SYSTEM + POINTS ECONOMY
// ────────────────────────────────────────────────────────────────────────

// Records a buyer unlocking a specific (randomly-selected-server-side) photo.
model MysteryUnlock {
  id               String    @id @default(cuid())
  buyerId          String
  photoId          String

  requestedTier    ScoreTier?
  pointsSpent      Int
  platformFee      Int
  sellerEarning    Int

  // Set when this unlock was one line item of a multi-photo bundle
  // purchase (see BundleUnlock) rather than a standalone unlock, purely
  // for grouping/reporting — the points/fee/earning split above is still
  // computed and recorded per-photo either way.
  bundleUnlockId   String?

  createdAt        DateTime  @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  bundleUnlock BundleUnlock? @relation(fields: [bundleUnlockId], references: [id], onDelete: SetNull)

  transactions PointTransaction[]

  @@index([buyerId, createdAt])
  @@index([photoId])
  @@index([bundleUnlockId])
}

model PointTransaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Int               // signed: negative = debit, positive = credit
  balanceAfter    Int

  relatedUnlockId String?
  relatedPhotoId  String?
  description     String

  createdAt       DateTime          @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlock MysteryUnlock?  @relation(fields: [relatedUnlockId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ────────────────────────────────────────────────────────────────────────
// SOCIAL
// ────────────────────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([photoId])
}

model Comment {
  id        String    @id @default(cuid())
  photoId   String
  userId    String
  parentId  String?

  body      String    @db.VarChar(1000)
  isPinned  Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo   Photo             @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  reports Report[]          @relation("ReportedComment")

  @@index([photoId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Collection {
  id          String               @id @default(cuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  visibility  CollectionVisibility @default(PUBLIC)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  collectionId String
  photoId      String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo      Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([collectionId, photoId])
  @@index([photoId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
}

// ────────────────────────────────────────────────────────────────────────
// GAMIFICATION
// ────────────────────────────────────────────────────────────────────────

model Achievement {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  icon         String
  category     String
  xpReward     Int      @default(0)
  pointsReward Int      @default(0)
  criteria     Json
  createdAt    DateTime @default(now())

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Mission {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  description  String
  period       MissionPeriod
  xpReward     Int           @default(0)
  pointsReward Int           @default(0)
  targetCount  Int
  criteria     Json
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime      @default(now())

  progress UserMission[]

  @@index([period, startsAt, endsAt])
}

model UserMission {
  id          String    @id @default(cuid())
  userId      String
  missionId   String
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  icon        String
  description String
  tier        Int      @default(1)
  createdAt   DateTime @default(now())

  awardedTo UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ────────────────────────────────────────────────────────────────────────
// ADMIN / MODERATION / PLATFORM
// ────────────────────────────────────────────────────────────────────────

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  reason     ReportReason
  details    String?          @db.Text
  status     ReportStatus     @default(PENDING)

  photoId    String?
  commentId  String?
  reportedUserId String?

  reviewedById String?
  reviewedAt   DateTime?
  resolutionNote String?

  createdAt  DateTime         @default(now())

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?    @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  photo        Photo?   @relation("ReportedPhoto", fields: [photoId], references: [id], onDelete: Cascade)
  comment      Comment? @relation("ReportedComment", fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType])
  @@index([reportedUserId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation("Actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  isActive    Boolean   @default(true)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive, publishedAt])
}

model PlatformSetting {
  key           String   @id
  value         Json
  description   String?
  updatedById   String?
  updatedAt     DateTime @updatedAt

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model FeaturedCreator {
  id           String   @id @default(cuid())
  sellerId     String
  photoId      String?
  position     Int      @default(0)
  startAt      DateTime
  endAt        DateTime
  createdById  String
  createdAt    DateTime @default(now())

  seller    User   @relation("FeaturedSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  photo     Photo? @relation("FeaturedPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  createdBy User   @relation("FeaturedCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([startAt, endAt])
}

// Cached monthly rollups for seller analytics charts (avoids heavy
// aggregation queries on every dashboard load).
model SellerMonthlyStat {
  id             String   @id @default(cuid())
  sellerId       String
  month          DateTime // first day of month, UTC
  uploadsCount   Int      @default(0)
  approvedCount  Int      @default(0)
  rejectedCount  Int      @default(0)
  unlocksCount   Int      @default(0)
  pointsEarned   Int      @default(0)
  followersGained Int     @default(0)
  avgOverallScore Float?
  updatedAt      DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, month])
}

model SearchQuery {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────
// GROWTH & ENGAGEMENT (Stage 15)
// ────────────────────────────────────────────────────────────────────────

// One row per user per calendar day they did something streak-worthy
// (logged in, unlocked, uploaded). Deliberately separate from the
// denormalized User.streakCount/lastActiveDate fields: those two columns
// can tell you the *current* streak length, but not which specific days
// were active, which is what a visual streak calendar needs to render.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// Rolling per-month XP/unlock snapshot, updated incrementally alongside
// the all-time User.xp field rather than replacing it — the leaderboard
// reads whichever the visitor has selected (all-time vs this season)
// without needing a heavy historical aggregation query on every view.
model SeasonScore {
  id           String   @id @default(cuid())
  userId       String
  season       String   // e.g. "2026-07" (UTC year-month) — see lib/constants/season.ts
  xpEarned     Int      @default(0)
  unlocksCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
  @@index([season, xpEarned])
}

// A criteria-based alert, distinct from Wishlist (which saves one specific
// photo). A buyer sets a filter shape once; any newly-APPROVED photo
// matching it fires a notification instead of the buyer having to keep
// checking the marketplace manually.
model SavedSearchAlert {
  id          String       @id @default(cuid())
  userId      String
  breed       String?
  ageCategory AgeCategory?
  energyLevel EnergyLevel?
  color       String?
  maxPrice    Int?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  lastMatchedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, breed, ageCategory, energyLevel])
}

// Redeemable catalog — deliberately not real-money: every category here
// is either cosmetic (badge), promotional (a timed featured-creator slot),
// or a percentage discount on the platform's own commission cut, never a
// cash-out. See actions/rewards/redeem.ts for the redemption logic per
// category.
model RewardItem {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  description String
  category    RewardCategory
  pointsCost  Int
  metadata    Json?          // e.g. { "badgeKey": "..." } or { "boostDays": 3 } or { "discountPercent": 10, "days": 30 }
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id           String     @id @default(cuid())
  userId       String
  rewardItemId String
  redeemedAt   DateTime   @default(now())
  expiresAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItem RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)

  @@index([userId, redeemedAt])
}

// A themed, real-photo voting contest — entries are always existing
// APPROVED Photo rows a seller already uploaded and sells in the
// marketplace, never a separately-submitted or AI-generated image, so a
// contest can't become a backdoor for unmoderated content.
model Contest {
  id                 String        @id @default(cuid())
  title              String
  description        String
  period             MissionPeriod // reuses WEEKLY/MONTHLY; DAILY is valid but unused by the UI
  status             ContestStatus @default(UPCOMING)
  startsAt           DateTime
  endsAt             DateTime
  firstPrizePoints   Int           @default(200)
  secondPrizePoints  Int           @default(100)
  thirdPrizePoints   Int           @default(50)
  createdAt          DateTime      @default(now())

  entries ContestEntry[]

  @@index([status, startsAt, endsAt])
}

model ContestEntry {
  id         String   @id @default(cuid())
  contestId  String
  photoId    String
  sellerId   String
  voteCount  Int      @default(0)
  rank       Int?
  prizePointsAwarded Int?
  createdAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  photo   Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  votes   ContestVote[]

  @@unique([contestId, photoId])
  @@unique([contestId, sellerId]) // one entry per seller per contest
  @@index([contestId, voteCount])
}

model ContestVote {
  id         String   @id @default(cuid())
  contestId  String
  entryId    String
  voterId    String
  createdAt  DateTime @default(now())

  entry ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voter User         @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([contestId, voterId]) // one vote per user per contest
  @@index([entryId])
}

// An admin-curated set of real, already-approved photos sold together at
// a discount vs. unlocking each individually. BundleUnlock is the buyer's
// single purchase record; it fans out into one ordinary MysteryUnlock per
// photo (see actions/marketplace/unlock-bundle.ts) so collection views,
// seller earnings, and point ledgers all stay consistent with a normal
// single-photo unlock.
model Bundle {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Int
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User          @relation("BundleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  photos    BundlePhoto[]
  unlocks   BundleUnlock[]

  @@index([isActive])
}

model BundlePhoto {
  bundleId String
  photoId  String

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  photo  Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([bundleId, photoId])
  @@index([photoId])
}

model BundleUnlock {
  id          String   @id @default(cuid())
  buyerId     String
  bundleId    String
  pointsSpent Int
  createdAt   DateTime @default(now())

  buyer  User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  bundle Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  unlocks MysteryUnlock[]

  @@index([buyerId, createdAt])
  @@index([bundleId])
}

// Browser Web Push subscriptions (see lib/push/web-push.ts). One row per
// device/browser a user has granted permission on, since the same account
// can be subscribed from a phone and a laptop simultaneously.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
