{
  "name": "pawdrop",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate --schema=db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=db/prisma/schema.prisma",
    "db:seed": "tsx db/prisma/seed/seed.ts",
    "db:studio": "prisma studio --schema=db/prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "prisma": {
    "schema": "db/prisma/schema.prisma",
    "seed": "tsx db/prisma/seed/seed.ts"
  },
  "dependencies": {
    "next": "^15.5.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.6.3",
    "@prisma/client": "5.21.1",
    "prisma": "5.21.1",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "2.7.2",
    "zod": "3.23.8",
    "@tanstack/react-query": "5.59.16",
    "@tanstack/react-query-devtools": "5.59.16",
    "zustand": "5.0.0",
    "framer-motion": "11.11.9",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "recharts": "2.13.0",
    "ioredis": "5.4.1",
    "cloudinary": "2.5.1",
    "next-cloudinary": "6.16.0",
    "openai": "4.68.4",
    "resend": "4.0.1",
    "react-email": "3.0.2",
    "@react-email/components": "0.0.25",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.2",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "date-fns": "4.1.0",
    "nanoid": "5.0.7",
    "sharp": "0.33.5",
    "@radix-ui/react-avatar": "1.1.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-toast": "1.2.2",
    "@radix-ui/react-tooltip": "1.1.4",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.1",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-slider": "1.2.1",
    "next-themes": "0.3.0",
    "sonner": "1.5.0",
