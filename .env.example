# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://pawdrop:pawdrop@localhost:5432/pawdrop?schema=public"
DIRECT_URL="postgresql://pawdrop:pawdrop@localhost:5432/pawdrop?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Two Factor ---
TOTP_ISSUER="PawDrop"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="PawDrop <hello@pawdrop.app>"

# --- AI Scoring Service ---
AI_SCORING_PROVIDER="openai"
AI_SCORING_API_KEY=""
AI_SCORING_MODEL="gpt-4o-mini"

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Points economy defaults ---
PLATFORM_COMMISSION_PERCENT=20
STARTING_BUYER_POINTS=100
STARTING_SELLER_POINTS=0

# --- Admin bootstrap ---
ADMIN_SEED_EMAIL="admin@pawdrop.app"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# --- Cron (Vercel Cron / GitHub Actions scheduled workflow auth) ---
CRON_SECRET="replace-with-openssl-rand-base64-32"

# --- Web Push (generate with `npx web-push generate-vapid-keys`) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@pawdrop.app"
